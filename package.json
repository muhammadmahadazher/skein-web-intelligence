{
  "name": "skein-web-intelligence",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first web intelligence crawler with observable pipelines, strict SSRF protection, and evidence-ready exports.",
  "license": "MIT",
  "author": "Muhammad Mahad Azher",
  "homepage": "https://muhammadmahadazher.github.io/skein-web-intelligence/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadmahadazher/skein-web-intelligence.git"
  },
  "bugs": {
    "url": "https://github.com/muhammadmahadazher/skein-web-intelligence/issues"
  },
  "keywords": [
    "web-crawler",
    "web-intelligence",
    "web-scraping",
    "data-extraction",
    "local-first",
    "ssrf-protection",
    "fastapi",
    "rust",
    "react"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:source": "node --test tests/source-contract.test.mjs",
    "test:demo": "node scripts/validate-demo.mjs",
    "test:browser": "node tests/browser-exhaustive.mjs",
    "test:load": "node tests/load-api.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .codex-incomplete-node-modules-20260723 --ignore-pattern .codex-edit-staging --ignore-pattern .codex-edit-staging-2 --ignore-pattern .codex-design-review",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "brace-expansion": "file:tools/brace-expansion-compat",
    "braces": "file:tools/braces-safe",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "6.0.3",
    "vinext": "1.0.1",
    "vite": "8.3.4"
  },
  "type": "module",
  "overrides": {
    "brace-expansion": "file:tools/brace-expansion-compat",
    "braces": "$braces",
    "fast-uri": "3.1.8",
    "fflate": "0.7.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5"
  }
}
